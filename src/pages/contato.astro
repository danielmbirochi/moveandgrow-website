---
import BaseLayout from '../layouts/BaseLayout.astro';
import Label from '../components/Label.astro';
import ContactForm from '../components/ContactForm.astro';
import page from '../content/contato';

const path = '/contato/';
---
<BaseLayout seo={page.seo} breadcrumb={[{ name: page.breadcrumb, path }]}>
  <section class="bg-ground pt-16 pb-20 md:pt-28 md:pb-28" aria-labelledby="hero-title">
    <div class="mg-container grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Label as="p">{page.hero.label}</Label>
        <h1 id="hero-title" class="mt-6 lg:text-[3.5rem]">{page.hero.headline}</h1>
        <p class="mg-lead mt-8 max-w-[34rem]">{page.hero.lead}</p>
      </div>
      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
