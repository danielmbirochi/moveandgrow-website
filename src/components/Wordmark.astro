---
import { brand } from '../../visual-identity.config';
import source from '../assets/logo.svg?raw';
import { paintLogo } from '../lib/logo';

interface Props {
  /** Draw for an inverse (dark in oficina) background. */
  inverse?: boolean;
  class?: string;
}
const { inverse = false, class: className = '' } = Astro.props;

// Inlined so the ink follows the text colour and the accent follows the theme.
// The visible name comes from the sr-only text, so the SVG's own title goes.
const svg = paintLogo(source, 'currentColor', 'var(--color-accent)')
  .replace(/\s*<title>.*?<\/title>/, '')
  .replace('<svg ', '<svg class="h-8 w-auto sm:h-9" aria-hidden="true" ');
---
<span class:list={['inline-flex', inverse ? 'text-inverse-ink' : 'text-ink', className]}>
  <Fragment set:html={svg} />
  <span class="sr-only">{brand.name}</span>
</span>
