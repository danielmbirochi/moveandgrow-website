---
import { brand } from '../../visual-identity.config';

interface Props {
  /** Draw for an inverse (dark in oficina) background. */
  inverse?: boolean;
  class?: string;
}
const { inverse = false, class: className = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-3', className]}>
  <span
    aria-hidden="true"
    class:list={[
      'relative inline-block size-7 shrink-0 overflow-hidden rounded-control',
      inverse ? 'bg-inverse-ink' : 'bg-ink',
    ]}
  >
    <span class="absolute right-0 bottom-0 size-3 bg-accent"></span>
  </span>
  <span class="mg-heading text-xl leading-none tracking-tight whitespace-nowrap">{brand.name}</span>
</span>
