---
import Wordmark from './Wordmark.astro';
import { brand } from '../../visual-identity.config';
import { site } from '../site.config';
import shell from '../content/shell';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current === href.replace(/\/$/, '');
---
<header class="border-b border-border bg-ground">
  <div class="mg-container flex min-h-18 items-center justify-between gap-6">
    <a href="/" class="no-underline" aria-label={`${brand.name}, ${shell.homeLink}`}>
      <Wordmark />
    </a>

    <nav aria-label={shell.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="mg-navlink"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contato/" class="mg-btn mg-btn--primary hidden lg:inline-flex">{shell.cta}</a>

    <details class="mg-menu lg:hidden">
      <summary class="mg-btn mg-btn--secondary min-h-11 px-4 py-2">
        <span class="mg-menu__open">{shell.menu}</span>
        <span class="mg-menu__close">{shell.menuClose}</span>
      </summary>
      <nav aria-label={shell.mainNav} class="mg-menu__panel bg-ground border-b border-border">
        <ul class="mg-container flex flex-col py-4">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="mg-menu__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-5 pb-2">
            <a href="/contato/" class="mg-btn mg-btn--primary w-full">{shell.cta}</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 20;
  }
  .mg-navlink {
    font-weight: var(--mg-weight-strong);
    font-size: 0.9375rem;
    text-decoration: none;
    padding-block: 0.375rem;
    border-bottom: 0.125rem solid transparent;
  }
  .mg-navlink:hover {
    border-bottom-color: var(--color-border);
  }
  .mg-navlink[aria-current='page'] {
    border-bottom-color: var(--color-accent);
  }
  .mg-menu summary {
    list-style: none;
  }
  .mg-menu summary::-webkit-details-marker {
    display: none;
  }
  .mg-menu__close,
  .mg-menu[open] .mg-menu__open {
    display: none;
  }
  .mg-menu[open] .mg-menu__close {
    display: inline;
  }
  .mg-menu__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
  }
  .mg-menu__link {
    display: block;
    padding-block: 0.875rem;
    font-family: var(--font-heading);
    font-weight: var(--mg-weight-heading);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 0.0625rem solid var(--color-border);
  }
  .mg-menu__link[aria-current='page'] {
    color: var(--color-accent-text);
  }
</style>
