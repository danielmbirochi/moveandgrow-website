{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run og:*)",
      "Bash(npm run dev:*)",
      "Bash(node scripts/screenshots.mjs:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin conteudo/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh auth status:*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push */main)",
      "Bash(git push */main *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)"
    ]
  }
}
