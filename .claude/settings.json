{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run og:*)",
      "Bash(npm run dev:*)",
      "Bash(node scripts/screenshots.mjs:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh auth status:*)"
